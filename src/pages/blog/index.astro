---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { UI } from '../../i18n/ui';
import TagBadge from '../../components/shared/TagBadge.astro';
import { getReadingTime } from '../../utils/reading-time';

const lang = 'zh';
const t = UI[lang];

const allPosts = Object.values(import.meta.glob('../../content/blog/*.zh.md', { eager: true })) as any[];
const posts = allPosts
  .filter((p) => !p.frontmatter.draft)
  .sort((a, b) => new Date(b.frontmatter.published).getTime() - new Date(a.frontmatter.published).getTime());
---

<BaseLayout lang={lang} title={t.nav.blog}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold text-primary mb-2">📝 {t.nav.blog}</h1>
    <p class="text-secondary mb-8">{lang === 'zh' ? '技术思考与个人反思' : 'Tech thoughts and personal reflections'}</p>

    {posts.length === 0 ? (
      <p class="text-secondary">{lang === 'zh' ? '暂无文章' : 'No posts yet'}</p>
    ) : (
      <div class="flex flex-col gap-6">
        {posts.map((p) => (
          <a
            href={`/blog/${p.frontmatter.slug}/`}
            class="group block rounded-2xl border border-theme bg-card hover:bg-card-hover hover:-translate-y-0.5 transition-all duration-200 p-5 sm:p-6"
          >
            <h3 class="text-lg font-semibold text-primary group-hover:text-[var(--accent-1)] transition-colors">
              {p.frontmatter.title}
            </h3>
            <p class="text-sm text-secondary mt-1.5 line-clamp-2">{p.frontmatter.description}</p>
            <div class="flex flex-wrap items-center gap-3 mt-3">
              <div class="flex flex-wrap gap-1.5">
                {p.frontmatter.tags?.map((tag: string) => <TagBadge label={tag} />)}
              </div>
              <span class="text-xs text-secondary ml-auto">
                {new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(p.frontmatter.published))}
                &nbsp;&middot;&nbsp;
                {getReadingTime(p.rawContent?.() ?? '', 'zh')} 分钟
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
