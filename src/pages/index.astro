---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCard from '../components/home/HeroCard.astro';
import SkillsCard from '../components/home/SkillsCard.astro';
import ProjectsCard from '../components/home/ProjectsCard.astro';
import MilestonesCard from '../components/home/MilestonesCard.astro';
import WritingCard from '../components/home/WritingCard.astro';
import milestonesData from '../content/milestones/milestones.json';

const lang = 'zh';

const allProjects = Object.values(import.meta.glob('../content/projects/*.zh.md', { eager: true })) as any[];
const zhProjects = allProjects
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .map((p: any) => ({
    title: p.frontmatter.title, tagline: p.frontmatter.tagline,
    slug: p.frontmatter.urlSlug, tags: p.frontmatter.tags || [],
    date: new Date(p.frontmatter.date), image: p.frontmatter.image,
  }));

const allPosts = Object.values(import.meta.glob('../content/blog/*.zh.md', { eager: true })) as any[];
const posts = allPosts
  .filter((p: any) => !p.frontmatter.draft)
  .sort((a: any, b: any) => new Date(b.frontmatter.published).getTime() - new Date(a.frontmatter.published).getTime())
  .map((p: any) => ({ title: p.frontmatter.title, slug: p.frontmatter.slug, published: new Date(p.frontmatter.published) }));

const milestones = milestonesData.milestones.slice(0, 4).map((m) => ({
  date: m.date, type: m.type, title: m.zh.title,
}));
---

<BaseLayout lang={lang}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 py-10 sm:py-16">
    <!-- Hero — full width -->
    <div class="mb-10 sm:mb-14">
      <HeroCard lang={lang} />
    </div>

    <!-- 2x2 Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
      <ProjectsCard lang={lang} projects={zhProjects} />
      <WritingCard lang={lang} posts={posts} />
      <SkillsCard lang={lang} />
      <MilestonesCard lang={lang} milestones={milestones} />
    </div>
  </div>
</BaseLayout>
