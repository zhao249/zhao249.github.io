---
import { UI, type Lang } from '../../i18n/ui';
import BentoCard from '../shared/BentoCard.astro';

interface Milestone { date: string; type: string; title: string }

interface Props { lang: Lang; milestones: Milestone[] }

const typeColors: Record<string, string> = {
  career: 'var(--accent-1)', learning: 'var(--accent-1)', opensource: 'var(--accent-1)',
  life: '#3fb950', award: '#d29922',
};

const { lang, milestones } = Astro.props;
const t = UI[lang];
const milestonesPath = lang === 'zh' ? '/milestones/' : '/en/milestones/';
---

<BentoCard title={lang === 'zh' ? '近期里程碑' : 'Recent Milestones'}>
  {milestones.length === 0 ? (
    <p class="text-sm text-secondary">{lang === 'zh' ? '即将上线' : 'Coming soon'}</p>
  ) : (
    <div class="flex flex-col gap-0">
      {milestones.slice(0, 4).map((m, i) => (
        <div class="flex gap-3 py-1.5 first:pt-0 last:pb-0">
          <div class="relative flex flex-col items-center pt-1.5">
            <div class="h-2 w-2 rounded-full shrink-0" style={`background-color:${typeColors[m.type] ?? 'var(--border)'}`}></div>
            {i < milestones.slice(0, 4).length - 1 && <div class="w-px flex-1 bg-[var(--border)] mt-0.5"></div>}
          </div>
          <div class="min-w-0">
            <p class="text-[11px] text-secondary font-mono">{m.date}</p>
            <p class="text-sm text-primary line-clamp-2">{m.title}</p>
          </div>
        </div>
      ))}
    </div>
  )}
  <a href={milestonesPath} class="inline-flex items-center gap-1 mt-3 text-xs font-medium text-[var(--accent-1)] hover:opacity-80 transition-opacity duration-150">
    {t.viewAll}
  </a>
</BentoCard>
