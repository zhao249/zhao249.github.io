---
import { siteConfig } from '../../content/site-config';
import { UI, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const tagline = siteConfig.tagline[lang];
const bio = siteConfig.bio[lang];

const socialLabels: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  twitter: 'X',
  email: 'Email',
};
---

<div class="flex flex-col items-center text-center py-6 sm:py-8">
  <!-- Avatar -->
  <img
    src={siteConfig.avatar}
    alt="Avatar"
    class="h-20 w-20 rounded-full border-2 border-theme object-cover bg-card shrink-0 mb-5"
    width="80"
    height="80"
    loading="eager"
    onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
  />
  <div class="h-20 w-20 rounded-full border-2 border-theme bg-card shrink-0 items-center justify-center hidden mb-5">
    <span class="text-2xl font-semibold text-[var(--accent-1)]">{siteConfig.name[0]}</span>
  </div>

  <!-- Name & Tagline -->
  <h1 class="text-2xl sm:text-3xl font-bold text-primary tracking-tight">
    {siteConfig.name}
  </h1>
  <p class="text-sm text-secondary mt-2 max-w-md">{tagline}</p>
  <p class="text-sm text-secondary mt-3 max-w-lg leading-relaxed whitespace-pre-line">{bio}</p>

  <!-- CTA -->
  <a
    href={lang === 'zh' ? '/works/' : '/en/works/'}
    class="inline-flex items-center gap-1.5 mt-5 rounded-lg bg-[var(--accent-1)] px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity duration-150"
  >
    {lang === 'zh' ? '查看作品' : 'View Works'}
    <span aria-hidden="true">→</span>
  </a>

  <!-- Social links -->
  <div class="flex flex-wrap justify-center gap-1 mt-5">
    {siteConfig.socials.map((s) => (
      <a
        href={s.url}
        target="_blank"
        rel="noopener noreferrer me"
        class="rounded-md px-3 py-1.5 text-xs font-medium text-secondary hover:text-primary hover:bg-card-hover transition-colors duration-150"
        aria-label={s.name}
      >
        {socialLabels[s.icon] ?? s.name}
      </a>
    ))}
  </div>
</div>
