---
import { UI, type Lang } from '../../i18n/ui';
import BentoCard from '../shared/BentoCard.astro';
import TagBadge from '../shared/TagBadge.astro';

interface Project {
  title: string; tagline: string; slug: string; tags: string[]; date: Date; image?: string;
}

interface Props { lang: Lang; projects: Project[] }

const { lang, projects } = Astro.props;
const t = UI[lang];
const worksPath = lang === 'zh' ? '/works/' : '/en/works/';
---

<BentoCard title={lang === 'zh' ? '核心项目' : 'Featured Projects'}>
  {projects.length === 0 ? (
    <p class="text-sm text-secondary">{lang === 'zh' ? '项目即将上线' : 'Projects coming soon'}</p>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {projects.slice(0, 2).map((p) => (
        <a
          href={`${worksPath}${p.slug}/`}
          class="group/item block rounded-lg border border-theme bg-[var(--bg-base)] hover:bg-card-hover transition-colors duration-150 overflow-hidden"
        >
          {p.image && <img src={p.image} alt={p.title} class="w-full h-28 object-cover" loading="lazy" />}
          <div class="p-3.5">
            <h4 class="text-sm font-semibold text-primary group-hover/item:text-[var(--accent-1)] transition-colors duration-150">{p.title}</h4>
            <p class="text-xs text-secondary mt-0.5 line-clamp-2">{p.tagline}</p>
            <div class="flex flex-wrap gap-1 mt-2">
              {p.tags.slice(0, 4).map((tag: string) => <TagBadge label={tag} />)}
            </div>
          </div>
        </a>
      ))}
    </div>
  )}
  <a href={worksPath} class="inline-flex items-center gap-1 mt-4 text-xs font-medium text-[var(--accent-1)] hover:opacity-80 transition-opacity duration-150">
    {t.viewAll}
  </a>
</BentoCard>
