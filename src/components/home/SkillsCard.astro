---
import { skills } from '../../content/site-config';
import { UI, type Lang } from '../../i18n/ui';
import BentoCard from '../shared/BentoCard.astro';
import SkillBar from '../shared/SkillBar.astro';

interface Props { lang: Lang }

const { lang } = Astro.props;
const langSkills = skills[lang];
---

<BentoCard title={lang === 'zh' ? '技能' : 'Skills'}>
  <div class="flex flex-col gap-4">
    {langSkills.map((cat) => (
      <div>
        <p class="text-[11px] font-semibold text-secondary uppercase tracking-widest mb-2.5">{cat.category}</p>
        <div class="flex flex-col gap-2">
          {cat.items.map((item) => <SkillBar skill={item} />)}
        </div>
      </div>
    ))}
  </div>
</BentoCard>
