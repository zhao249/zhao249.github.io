---
import { skills } from '../../content/site-config';
import { UI, type Lang } from '../../i18n/ui';
import BentoCard from '../shared/BentoCard.astro';
import SkillBar from '../shared/SkillBar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const langSkills = skills[lang];
---

<BentoCard lang={lang} title={lang === 'zh' ? '技能' : 'Skills'} icon="📊">
  <div class="flex flex-col gap-4">
    {langSkills.map((cat) => (
      <div>
        <p class="text-xs font-semibold text-secondary uppercase tracking-wider mb-2">{cat.category}</p>
        <div class="flex flex-col gap-2.5">
          {cat.items.map((item) => (
            <SkillBar lang={lang} skill={item} />
          ))}
        </div>
      </div>
    ))}
  </div>
</BentoCard>
