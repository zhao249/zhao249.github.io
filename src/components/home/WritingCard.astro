---
import { UI, type Lang } from '../../i18n/ui';
import BentoCard from '../shared/BentoCard.astro';

interface Post { title: string; slug: string; published: Date }

interface Props { lang: Lang; posts: Post[] }

const { lang, posts } = Astro.props;
const t = UI[lang];
const blogPath = lang === 'zh' ? '/blog/' : '/en/blog/';

const fmt = (d: Date) => { try { return new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', { year:'numeric', month:'short', day:'numeric' }).format(d); } catch { return String(d); } };
---

<BentoCard title={lang === 'zh' ? '最新思考' : 'Latest Writing'}>
  {posts.length === 0 ? (
    <p class="text-sm text-secondary">{lang === 'zh' ? '文章即将发布' : 'Posts coming soon'}</p>
  ) : (
    <div class="flex flex-col gap-2.5">
      {posts.slice(0, 3).map((p) => (
        <a href={`${blogPath}${p.slug}/`} class="group/item block">
          <p class="text-sm text-primary font-medium group-hover/item:text-[var(--accent-1)] transition-colors duration-150 line-clamp-2">{p.title}</p>
          <p class="text-[11px] text-secondary mt-0.5">{fmt(p.published)}</p>
        </a>
      ))}
    </div>
  )}
  <a href={blogPath} class="inline-flex items-center gap-1 mt-3 text-xs font-medium text-[var(--accent-1)] hover:opacity-80 transition-opacity duration-150">
    {t.viewAll}
  </a>
</BentoCard>
