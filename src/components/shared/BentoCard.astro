---
interface Props {
  title?: string;
  icon?: string;
  href?: string;
  class?: string;
}

const { title, icon, href = '', class: extraClass = '' } = Astro.props;
const isLink = href.length > 0;
const Tag = isLink ? 'a' : 'div';
---

<Tag
  href={isLink ? href : undefined}
  class:list={[
    'group relative block rounded-xl border border-theme bg-card p-6',
    'transition-[background-color,transform] duration-150 ease-out',
    isLink ? 'cursor-pointer hover:bg-card-hover hover:-translate-y-px' : '',
    extraClass,
  ]}
>
  {icon && <span class="text-sm mb-3 block opacity-70">{icon}</span>}
  {title && <h3 class="text-sm font-semibold text-primary mb-2 tracking-tight">{title}</h3>}
  <slot />
</Tag>
