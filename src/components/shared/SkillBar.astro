---
import type { SkillItem } from '../../content/site-config';

interface Props {
  skill: SkillItem;
}

const levelBars: Record<string, string> = {
  mastered: 'w-full',
  proficient: 'w-3/4',
  working: 'w-1/2',
  learning: 'w-1/4',
};

const { skill } = Astro.props;
const barWidth = levelBars[skill.level];
const isLearning = skill.level === 'learning';
---

<div class="flex items-center justify-between gap-3 group/skill" title={skill.level}>
  <span class="text-sm text-primary">{skill.name}</span>
  <div class="h-1 flex-1 rounded-full bg-[var(--border)] overflow-hidden max-w-[60px]">
    <div
      class:list={[
        'h-full rounded-full transition-all duration-300',
        isLearning ? 'border border-dashed border-[var(--accent-1)] bg-transparent' : '',
        skill.level === 'mastered' ? 'bg-[var(--accent-1)]' : '',
        skill.level === 'proficient' ? 'bg-[var(--accent-1)] opacity-70' : '',
        skill.level === 'working' ? 'bg-[var(--accent-1)] opacity-40' : '',
        barWidth,
      ]}
    ></div>
  </div>
</div>
